{
  "name": "dsh-retry-manager",
  "version": "0.1.0",
  "description": "DSH 模型请求重试管理：模型默认、对话覆盖与原生重试状态。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node scripts/integration.mjs",
    "check:privacy": "node scripts/privacy.mjs"
  },
  "dependencies": {
    "write-file-atomic": "^7.0.0",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm-retry": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm-retry": {
      "optional": true
    }
  }
}
